/**
 * Core Philosophy: This ruleset enforces a hybrid security model for an e-commerce
 * application. It combines a public, read-only catalog for products with a strict,
 * user-ownership model for all personal data. The primary goal is to allow anyone
 * to browse the store, while ensuring that user information, orders, and
 * recommendations are accessible only by the owning user.
 *
 * Data Structure: The data is organized into two main top-level collections:
 * 1.  /products: A public collection containing all product information.
 * 2.  /users: A private collection where each user's data is stored under a
 *     document named with their UID (`/users/{userId}`). All related private
 *     data, such as orders and recommendations, are stored in subcollections
 *     under this user-specific document.
 *
 * Key Security Decisions:
 * - Product Catalog: The `/products` collection is publicly readable by anyone,
 *   including unauthenticated users, to facilitate window shopping. All client-side
 *   writes to this collection are disabled to ensure catalog integrity, presuming
 *   management is handled by a trusted backend server or admin SDK.
 * - User Privacy: The top-level `/users` collection cannot be listed, preventing
 *   malicious actors from enumerating all registered users.
 * - Strict Ownership: All documents and subcollections under `/users/{userId}` are
 *   strictly owned by the user whose UID matches `{userId}`. A user can only
 *   read from or write to their own data tree.
 * - Read-Only Recommendations: Product recommendations are considered generated by a
 *   backend service. Therefore, they are read-only for the user and cannot be
 *   modified from the client.
 *
 * Denormalization for Authorization: The ruleset relies heavily on path-based
 * authorization. By nesting all user-specific data under `/users/{userId}`, rules
 * can make fast and secure ownership decisions by simply checking the `{userId}`
 * wildcard against the requesting user's `request.auth.uid`. This completely
 * avoids slow and costly `get()` calls for authorization checks on user content.
 * Additionally, relationship integrity is enforced on creation (e.g., an Order's
 * `userId` field must match the path) and immutability is enforced on updates,
 * ensuring relational links cannot be tampered with.
 *
 * Structural Segregation: The clear separation between the public `/products`
 * collection and the private `/users/{userId}` data trees is a core design choice.
 * This segregation simplifies security logic, especially for `list` operations,
 * as queries do not need to filter mixed-sensitivity data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for concise and reusable logic
    //------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the foundation of the user-ownership model.
     * @param userId The user ID to check against the request's auth UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Ensures an operation is performed by the owner on an existing document.
     * CRITICAL for preventing writes to non-existent paths.
     * @param userId The user ID to check for ownership.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // Collection Rules
    //------------------------------------------------

    /**
     * @description Products are public for browsing but managed by the backend.
     * @path        /products/{productId}
     * @allow       Any user (authed or not) can read product details. (get, list)
     * @deny        Any client attempts to create, update, or delete products.
     * @principle   Public read access for a catalog, with writes restricted to a trusted environment (backend/admin).
     */
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description A user's own profile document.
     * @path        /users/{userId}
     * @allow       A user can create their own profile, then read, update, or delete it. (get, create, update, delete)
     * @deny        A user tries to read another user's profile or list all users.
     * @principle   Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description A user's orders, nested for ownership and privacy.
     * @path        /users/{userId}/orders/{orderId}
     * @allow       A user can create, read, update, and delete their own orders. (get, list, create, update, delete)
     * @deny        A user tries to access another user's orders.
     * @principle   Enforces document ownership for all operations within a user-specific subcollection.
     */
    match /users/{userId}/orders/{orderId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description The specific items within one of a user's orders.
     * @path        /users/{userId}/orders/{orderId}/orderItems/{orderItemId}
     * @allow       A user can manage the items within their own orders. (get, list, create, update, delete)
     * @deny        A user tries to read or modify items in an order that is not theirs.
     * @principle   Ownership is inherited from the path, securing nested subcollections efficiently.
     */
    match /users/{userId}/orders/{orderId}/orderItems/{orderItemId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.orderId == orderId;
      allow update: if isExistingOwner(userId) && request.resource.data.orderId == resource.data.orderId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Personalized product recommendations for a user.
     * @path        /users/{userId}/productRecommendations/{productRecommendationId}
     * @allow       A user can read their own recommendations. (get, list)
     * @deny        A user tries to read another's recommendations or modify their own.
     * @principle   Secures machine-generated data as read-only for the intended user.
     */
    match /users/{userId}/productRecommendations/{productRecommendationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}