
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          "QZavnE0270YjhMHsyQOb7FBzFSK2",
          "UaoQYEmCthasXz2UQlAEhHWZCGE2"
        ];
    }

    // PRODUCTS
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // BANNERS
    match /banners/{bannerId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // UNVERIFIED ORDERS (Aguardando aprovação do admin)
    match /unverified-orders/{orderId} {
        allow read, write: if isAdmin();
        allow create: if request.auth != null;
    }

    // USERS
    match /users/{userId} {
      allow list: if isAdmin();

      allow create: if request.auth != null && request.auth.uid == userId;

      allow get, update: if request.auth != null && request.auth.uid == userId;

      allow delete: if false;

      // Allow admins to read/list orders for any user
      match /orders/{orderId} {
        allow get, list: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow create, update, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // COUPONS
    // Admins can manage coupons
    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }
    // Authenticated users can read/list coupons to apply them
    match /coupons/{couponId} {
      allow get, list: if request.auth != null;
    }


    // Rule for collection group query on 'orders'
    match /{path=**}/orders/{orderId} {
      allow read, list: if isAdmin();
    }
    
    // ACCESS LOGS (Allow anyone to write)
    match /access_logs/{logId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }


    // DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
